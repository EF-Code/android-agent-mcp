{
  "name": "android-agent-mcp",
  "version": "0.5.0",
  "description": "A local MCP server for observable, policy-controlled Android device operation.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "android-agent-mcp": "dist/index.js",
    "android-mcp": "dist/index.js",
    "scrcpy-agent": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EF-Code/android-agent-mcp.git"
  },
  "homepage": "https://github.com/EF-Code/android-agent-mcp#readme",
  "bugs": {
    "url": "https://github.com/EF-Code/android-agent-mcp/issues"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs/codex-setup.md",
    "docs/compatibility.md",
    "docs/configuration.md",
    "docs/installation.md",
    "docs/phone-setup.md",
    "docs/security-model.md",
    "docs/troubleshooting.md",
    "docs/visual-control.md",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build:test && node --test 'dist-test/tests/**/*.test.js'",
    "test:watch": "npm run build:test && node --test --watch 'dist-test/tests/**/*.test.js'",
    "test:physical": "ANDROID_AGENT_MCP_PHYSICAL=1 npm run build:test && ANDROID_AGENT_MCP_PHYSICAL=1 node --test 'dist-test/tests/physical-device/**/*.test.js'",
    "benchmark:visual": "npm run build && node scripts/benchmark-visual.mjs",
    "check:environment": "node scripts/check-environment.mjs",
    "install:guided": "node scripts/install.mjs",
    "install:local": "node scripts/install.mjs",
    "setup": "npm run build && node dist/index.js setup",
    "doctor": "npm run build && node dist/index.js doctor",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build && npm pack --dry-run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build",
    "build:test": "rm -rf dist-test && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@yume-chan/adb": "3.0.0-beta.2",
    "@yume-chan/adb-scrcpy": "3.0.0-beta.2",
    "@yume-chan/adb-server-node-tcp": "3.0.0-beta.2",
    "@yume-chan/scrcpy": "3.0.0-beta.2",
    "fast-xml-parser": "^5.10.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
