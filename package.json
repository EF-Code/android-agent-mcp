{
  "name": "scrcpy-agent",
  "version": "0.1.0",
  "description": "A local MCP server for safe, observable Android device development workflows.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "scrcpy-agent": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build:test && node --test 'dist-test/tests/**/*.test.js'",
    "test:watch": "npm run build:test && node --test --watch 'dist-test/tests/**/*.test.js'",
    "test:physical": "ANDROID_DEVICE_MCP_PHYSICAL=1 npm run build:test && ANDROID_DEVICE_MCP_PHYSICAL=1 node --test 'dist-test/tests/physical-device/**/*.test.js'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build",
    "build:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-xml-parser": "^5.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
